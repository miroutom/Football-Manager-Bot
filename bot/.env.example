# Скопируйте этот файл в «.env» в этой же папке bot/ и подставьте значения.
# Команда из корня проекта:  cp bot/.env.example bot/.env

# Токен от @BotFather (строка вида 123456789:AAH...)
TELEGRAM_BOT_TOKEN=

# Опционально: id пользователей Telegram через запятую (только они смогут пользоваться ботом).
# Пусто = бот отвечает всем, кто знает ссылку (для теста). Для приватного доступа — укажите id.
# Узнать id: @userinfobot
# ALLOWED_USER_IDS=111111111,222222222
